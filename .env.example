# Harborlight 本地体验配置示例
# 复制为 .env 或直接注入环境变量后启动

HL_ADDR=:8080
HL_DEMO_LOGIN=true
# OAuth 部署时设置管理员白名单，多个邮箱用逗号分隔
# HL_ADMIN_EMAILS=admin@example.com,ops@example.com

# 元数据库：留空 = SQLite；或 PostgreSQL：
# HL_DB=postgres://postgres:pass@localhost:5432/harborlight

# 会话缓存（可选）：
# HL_REDIS_URL=redis://localhost:6379/0

# 生产环境务必设置强随机密钥
# HL_SESSION_SECRET=change-me-to-a-long-random-string

# GitHub OAuth
# HL_OAUTH_PROVIDER=github
# HL_CLIENT_ID=
# HL_CLIENT_SECRET=
# HL_BASE_URL=http://localhost:8080
